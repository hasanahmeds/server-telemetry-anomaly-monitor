   "source": [
    "rand = np.random.RandomState(123)\n",
    "s = pd.Series(np.cumsum(rand.normal(size=300)), index=pd.date_range(start=\"2017-1-1\", periods=300, freq=\"D\"))\n",
    "\n",
    "plot(s);"
   ]
